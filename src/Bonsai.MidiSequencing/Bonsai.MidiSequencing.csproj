<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Bonsai Library containing reactive operators for MIDI sequencing, playback and software synthesis.</Description>
    <TargetFrameworks>net472;netstandard2.0</TargetFrameworks>
    <PackageTags>$(PackageTags) MIDI Sequencer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.8.5" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
  </ItemGroup>

</Project>
