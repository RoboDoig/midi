<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:midi="clr-namespace:Bonsai.Midi;assembly=Bonsai.Midi"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:num="clr-namespace:Bonsai.Numerics;assembly=Bonsai.Numerics"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:SequencerClock">
          <midi:Period>PT0.001S</midi:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:CameraCapture">
            <cv:Index>0</cv:Index>
            <cv:CaptureProperties />
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:Flip">
            <cv:Mode>Horizontal</cv:Mode>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:ConvertColor">
            <cv:Conversion>Bgr2Hsv</cv:Conversion>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:HsvThreshold">
            <cv:Lower>
              <cv:Val0>80</cv:Val0>
              <cv:Val1>50</cv:Val1>
              <cv:Val2>110</cv:Val2>
              <cv:Val3>0</cv:Val3>
            </cv:Lower>
            <cv:Upper>
              <cv:Val0>120</cv:Val0>
              <cv:Val1>255</cv:Val1>
              <cv:Val2>160</cv:Val2>
              <cv:Val3>0</cv:Val3>
            </cv:Upper>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:FindContours">
            <cv:Mode>External</cv:Mode>
            <cv:Method>ChainApproxNone</cv:Method>
            <cv:Offset>
              <cv:X>0</cv:X>
              <cv:Y>0</cv:Y>
            </cv:Offset>
            <cv:MinArea xsi:nil="true" />
            <cv:MaxArea xsi:nil="true" />
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:BinaryRegionAnalysis" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:LargestBinaryRegion" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>Centroid</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>X</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="dsp:Rescale">
            <dsp:Min>0</dsp:Min>
            <dsp:Max>600</dsp:Max>
            <dsp:RangeMin>40</dsp:RangeMin>
            <dsp:RangeMax>240</dsp:RangeMax>
            <dsp:RescaleType>Linear</dsp:RescaleType>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="PropertyMapping">
          <PropertyMappings>
            <Property Name="Tempo" />
          </PropertyMappings>
        </Builder>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:Transport">
          <midi:Tempo>124.04938252766927</midi:Tempo>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:ReadMidiFile">
          <midi:FileName>bass.mid</midi:FileName>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:PlaySequence">
          <midi:LaunchQuantization>4</midi:LaunchQuantization>
          <midi:Loop>true</midi:Loop>
          <midi:Channel>0</midi:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:TransposeNote">
          <midi:Semitones>-12</midi:Semitones>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:ReadMidiFile">
          <midi:FileName>arpeggio.mid</midi:FileName>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:PlaySequence">
          <midi:LaunchQuantization>4</midi:LaunchQuantization>
          <midi:Loop>true</midi:Loop>
          <midi:Channel>1</midi:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:CreateNoteSequence">
          <midi:Notes>E5 _ . A5 G5 _ E5 . F5 _ . C6 A5 _ _ .</midi:Notes>
          <midi:StepLength>0.5</midi:StepLength>
          <midi:Gate>0.8</midi:Gate>
          <midi:Velocity>90</midi:Velocity>
          <midi:Channel>2</midi:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:PlaySequence">
          <midi:LaunchQuantization>4</midi:LaunchQuantization>
          <midi:Loop>true</midi:Loop>
          <midi:Channel>3</midi:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Time.TotalSeconds</Selector>
      </Expression>
      <Expression xsi:type="rx:Accumulate" />
      <Expression xsi:type="Divide">
        <Operand xsi:type="DoubleProperty">
          <Value>25000</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="num:Sin" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:CreateControlChange">
          <midi:Channel>0</midi:Channel>
          <midi:ControlNumber>21</midi:ControlNumber>
          <midi:Value>0</midi:Value>
          <midi:Min>-1</midi:Min>
          <midi:Max>1</midi:Max>
        </Combinator>
      </Expression>
      <Expression xsi:type="Divide">
        <Operand xsi:type="DoubleProperty">
          <Value>10000</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="num:Sin" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:CreateControlChange">
          <midi:Channel>0</midi:Channel>
          <midi:ControlNumber>20</midi:ControlNumber>
          <midi:Value>0</midi:Value>
          <midi:Min>-1</midi:Min>
          <midi:Max>1</midi:Max>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midi:OutputDevice">
          <midi:Index>1</midi:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="midi:SoftwareSynth">
            <midi:Waveform>Sawtooth</midi:Waveform>
            <midi:Gain>0.25</midi:Gain>
            <midi:Attack>0.002</midi:Attack>
            <midi:Release>0.05</midi:Release>
            <midi:BufferLength>480</midi:BufferLength>
          </Combinator>
        </Builder>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="12" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="14" To="16" Label="Source1" />
      <Edge From="15" To="16" Label="Source2" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="33" Label="Source1" />
      <Edge From="18" To="20" Label="Source1" />
      <Edge From="19" To="20" Label="Source2" />
      <Edge From="20" To="33" Label="Source2" />
      <Edge From="21" To="23" Label="Source1" />
      <Edge From="22" To="23" Label="Source2" />
      <Edge From="23" To="33" Label="Source3" />
      <Edge From="24" To="25" Label="Source1" />
      <Edge From="25" To="26" Label="Source1" />
      <Edge From="26" To="27" Label="Source1" />
      <Edge From="26" To="30" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
      <Edge From="28" To="29" Label="Source1" />
      <Edge From="29" To="33" Label="Source4" />
      <Edge From="30" To="31" Label="Source1" />
      <Edge From="31" To="32" Label="Source1" />
      <Edge From="32" To="33" Label="Source5" />
      <Edge From="33" To="34" Label="Source1" />
      <Edge From="34" To="35" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>