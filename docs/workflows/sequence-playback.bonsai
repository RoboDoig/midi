<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:midiseq="clr-namespace:Bonsai.MidiSequencing;assembly=Bonsai.MidiSequencing"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:num="clr-namespace:Bonsai.Numerics;assembly=Bonsai.Numerics"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:SequencerClock">
          <midiseq:Period>PT0.001S</midiseq:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:CameraCapture">
            <cv:Index>0</cv:Index>
            <cv:CaptureProperties />
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:Flip">
            <cv:Mode>Horizontal</cv:Mode>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:ConvertColor">
            <cv:Conversion>Bgr2Hsv</cv:Conversion>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:HsvThreshold">
            <cv:Lower>
              <cv:Val0>80</cv:Val0>
              <cv:Val1>50</cv:Val1>
              <cv:Val2>110</cv:Val2>
              <cv:Val3>0</cv:Val3>
            </cv:Lower>
            <cv:Upper>
              <cv:Val0>120</cv:Val0>
              <cv:Val1>255</cv:Val1>
              <cv:Val2>160</cv:Val2>
              <cv:Val3>0</cv:Val3>
            </cv:Upper>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:FindContours">
            <cv:Mode>External</cv:Mode>
            <cv:Method>ChainApproxNone</cv:Method>
            <cv:Offset>
              <cv:X>0</cv:X>
              <cv:Y>0</cv:Y>
            </cv:Offset>
            <cv:MinArea xsi:nil="true" />
            <cv:MaxArea xsi:nil="true" />
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:BinaryRegionAnalysis" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="cv:LargestBinaryRegion" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>Centroid</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>X</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="dsp:Rescale">
            <dsp:Min>0</dsp:Min>
            <dsp:Max>600</dsp:Max>
            <dsp:RangeMin>40</dsp:RangeMin>
            <dsp:RangeMax>240</dsp:RangeMax>
            <dsp:RescaleType>Linear</dsp:RescaleType>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="PropertyMapping">
          <PropertyMappings>
            <Property Name="Tempo" />
          </PropertyMappings>
        </Builder>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:Transport">
          <midiseq:Tempo>124.04938252766927</midiseq:Tempo>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:ReadMidiFile">
          <midiseq:FileName>bass.mid</midiseq:FileName>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:PlaySequence">
          <midiseq:LaunchQuantization>4</midiseq:LaunchQuantization>
          <midiseq:Loop>true</midiseq:Loop>
          <midiseq:Channel>0</midiseq:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:TransposeNote">
          <midiseq:Semitones>-12</midiseq:Semitones>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:ReadMidiFile">
          <midiseq:FileName>arpeggio.mid</midiseq:FileName>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:PlaySequence">
          <midiseq:LaunchQuantization>4</midiseq:LaunchQuantization>
          <midiseq:Loop>true</midiseq:Loop>
          <midiseq:Channel>1</midiseq:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:CreateNoteSequence">
          <midiseq:Notes>E5 _ . A5 G5 _ E5 . F5 _ . C6 A5 _ _ .</midiseq:Notes>
          <midiseq:StepLength>0.5</midiseq:StepLength>
          <midiseq:Gate>0.8</midiseq:Gate>
          <midiseq:Velocity>90</midiseq:Velocity>
          <midiseq:Channel>2</midiseq:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:PlaySequence">
          <midiseq:LaunchQuantization>4</midiseq:LaunchQuantization>
          <midiseq:Loop>true</midiseq:Loop>
          <midiseq:Channel>3</midiseq:Channel>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Transport</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Time.TotalSeconds</Selector>
      </Expression>
      <Expression xsi:type="rx:Accumulate" />
      <Expression xsi:type="Divide">
        <Operand xsi:type="DoubleProperty">
          <Value>25000</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="num:Sin" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:CreateControlChange">
          <midiseq:Channel>0</midiseq:Channel>
          <midiseq:ControlNumber>21</midiseq:ControlNumber>
          <midiseq:Value>0</midiseq:Value>
          <midiseq:Min>-1</midiseq:Min>
          <midiseq:Max>1</midiseq:Max>
        </Combinator>
      </Expression>
      <Expression xsi:type="Divide">
        <Operand xsi:type="DoubleProperty">
          <Value>10000</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="num:Sin" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:CreateControlChange">
          <midiseq:Channel>0</midiseq:Channel>
          <midiseq:ControlNumber>20</midiseq:ControlNumber>
          <midiseq:Value>0</midiseq:Value>
          <midiseq:Min>-1</midiseq:Min>
          <midiseq:Max>1</midiseq:Max>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="midiseq:OutputDevice">
          <midiseq:Index>1</midiseq:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="midiseq:SoftwareSynth">
            <midiseq:Waveform>Sawtooth</midiseq:Waveform>
            <midiseq:Gain>0.25</midiseq:Gain>
            <midiseq:Attack>0.002</midiseq:Attack>
            <midiseq:Release>0.05</midiseq:Release>
            <midiseq:BufferLength>480</midiseq:BufferLength>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Event</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Event</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="12" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="14" To="16" Label="Source1" />
      <Edge From="15" To="16" Label="Source2" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="33" Label="Source1" />
      <Edge From="18" To="20" Label="Source1" />
      <Edge From="19" To="20" Label="Source2" />
      <Edge From="20" To="36" Label="Source1" />
      <Edge From="36" To="33" Label="Source2" />
      <Edge From="21" To="23" Label="Source1" />
      <Edge From="22" To="23" Label="Source2" />
      <Edge From="23" To="37" Label="Source1" />
      <Edge From="37" To="33" Label="Source3" />
      <Edge From="24" To="25" Label="Source1" />
      <Edge From="25" To="26" Label="Source1" />
      <Edge From="26" To="27" Label="Source1" />
      <Edge From="26" To="30" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
      <Edge From="28" To="29" Label="Source1" />
      <Edge From="29" To="33" Label="Source4" />
      <Edge From="30" To="31" Label="Source1" />
      <Edge From="31" To="32" Label="Source1" />
      <Edge From="32" To="33" Label="Source5" />
      <Edge From="33" To="34" Label="Source1" />
      <Edge From="34" To="35" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>